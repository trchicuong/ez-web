# EZWeb — Environment Variables
# Copy file này thành .env và điền thông tin thực

# ── Database ─────────────────────────────────────────────────
DB_ROOT_PASS=changeme_root
DB_NAME=ezweb
DB_USER=ezweb
DB_PASS=changeme

# ── App ──────────────────────────────────────────────────────
APP_NAME=EZWeb
APP_BASE_URL=https://yourdomain.com

# ── Mail (Gmail SMTP) ─────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your@gmail.com
MAIL_PASS=your_app_password

# ── Bank (SePay QR) ──────────────────────────────────────────
BANK_ID=MB
BANK_NAME=MBBank
BANK_ACCOUNT=9831028122006
BANK_OWNER=TRAN CHI CUONG

# ── Topup ─────────────────────────────────────────────────────
TOPUP_PROVIDER=sepay

# ── Gemini AI ─────────────────────────────────────────────────
GEMINI_API_KEY=your_google_ai_api_key